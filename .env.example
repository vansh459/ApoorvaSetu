# ------------------------------------------------------------------------------
# ApoorvaSetu environment
#
# Demo mode (default): leave every value empty. The app boots against the
# bundled localStorage dataset with no backend or secrets configured.
#
# Production mode: set VITE_DATA_MODE=supabase and configure the values below.
# Only VITE_* values reach the browser. Everything else is server-only.
# ------------------------------------------------------------------------------

# Data source: "demo" (localStorage) or "supabase" (authenticated backend).
# When unset, Supabase is used if the two VITE_ Supabase values are present.
VITE_DATA_MODE=demo

# Browser-safe Supabase project settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose these to the browser, never prefix with VITE_.
# The anon key is also read server-side to verify user access tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses row level security. Server-side jobs only (outbox delivery, cron sweep).
SUPABASE_SERVICE_ROLE_KEY=

# Protects the scheduled sweep endpoint. Server-side only.
CRON_SECRET=

# Google Gemini AI Assistant Configuration (server only).
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview

# Comma-separated browser origins allowed to call /api/assistant/chat and
# /api/documents/verify. Leave empty in local development to allow localhost
# only. In production set the exact deployed origins, for example:
# https://apoorvasetu.aicte-india.org
AI_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# AI document verification (server only)
# ------------------------------------------------------------------------------
# Python FastAPI extractor. Local: http://localhost:8090.
# Docker compose overrides this to http://doc-verifier:8090.
DOC_VERIFIER_URL=http://localhost:8090
# Optional shared secret between the Node API and the extractor.
DOC_VERIFIER_TOKEN=
# Maximum PDF size accepted by the Node API (default 8 MB).
DOC_MAX_BYTES=8388608
# Extractor limits.
DOC_MAX_PAGES=25
DOC_OCR_MIN_CHARS=40
DOC_OCR_DPI=200
