# ------------------------------------------------------------------------------
# ApoorvaSetu environment
#
# Demo mode (default): leave every value empty. The app boots against the
# bundled localStorage dataset with no backend or secrets configured.
#
# Postgres mode: build with VITE_DATA_MODE=postgres, set DATABASE_URL and run
# `npm run db:deploy` (or start the compose overlay, which migrates and seeds).
# Only VITE_* values reach the browser. Everything else is server-only.
# ------------------------------------------------------------------------------

# Data source baked into the bundle: "demo" (localStorage) or "postgres" (API).
VITE_DATA_MODE=demo

# Legacy Supabase data mode (P10). Leave empty unless using that path.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Postgres (Neon) ---------------------------------------------------------
# Use the pooled connection string for DATABASE_URL and the direct one for
# migrations (Neon: "-pooler" host with ?sslmode=require&pgbouncer=true).
DATABASE_URL=
DIRECT_URL=
# Seed the demo dataset on first boot only (skipped when users already exist).
SEED_ON_START=0
# Overwrite the demo dataset on boot. Destructive: local resets only.
SEED_FORCE=0
# Allows POST /api/admin/reset (truncate + reseed). Keep 0 outside local demos.
ALLOW_DEMO_RESET=0
# Set to 1 behind HTTPS so the session cookie carries the Secure flag.
COOKIE_SECURE=0
# Extra browser origin allowed to call the API (comma separated). Same-origin
# requests, localhost and the compose host are allowed by default.
APP_ORIGIN=

# ---- File storage ------------------------------------------------------------
# "local" writes to UPLOAD_DIR; "supabase" uploads to a private Storage bucket.
STORAGE_DRIVER=local
UPLOAD_DIR=data/uploads
UPLOAD_MAX_MB=25
# SERVER ONLY. Service-role key bypasses row level security: never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=institute-documents

# ---- Assistant ---------------------------------------------------------------
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview

# Comma-separated browser origins allowed to call /api/assistant/chat.
# Leave empty in local development to allow localhost only. In production set
# the exact deployed origins, for example: https://apoorvasetu.aicte-india.org
AI_ALLOWED_ORIGINS=

# Protects the scheduled sweep endpoint. Server-side only.
CRON_SECRET=
